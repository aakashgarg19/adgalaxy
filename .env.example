# Zoho SMTP credentials for the contact form (set these in Vercel project env vars)
# Generate an app-specific password at: https://accounts.zoho.in/home#security/app_passwords
ZOHO_USER=Admin@adgalaxy.in
ZOHO_PASS=your-zoho-app-password

# Optional overrides
# ZOHO_HOST=smtp.zoho.in      # use smtp.zoho.com if your account is on the global region
# ZOHO_PORT=465               # 465 (SSL) or 587 (STARTTLS)
# CONTACT_TO=Admin@adgalaxy.in # where enquiries are delivered (defaults to ZOHO_USER)
